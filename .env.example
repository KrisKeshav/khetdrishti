# Copy to .env and fill in. Never commit .env.

# --- LLM (required) ---
# One or more Groq keys, comma-separated. Each teammate can create a free key at https://console.groq.com/keys
# Multiple keys = automatic rotation when one hits the free-tier rate limit.
GROQ_API_KEYS=gsk_xxx
# Tried in order; on rate-limit / decommission the next one is used.
# Run scripts/smoke_test.py to confirm these still exist — Groq retires models without much notice.
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3

# --- Mandi prices (strongly recommended) ---
# Free key: register at https://data.gov.in -> My Account -> API key.
# Without it the public sample key is used, which returns only 10 rows per call.
DATA_GOV_IN_API_KEY=

# --- Satellite (recommended) ---
# Free Copernicus Data Space account: https://dataspace.copernicus.eu
# Then: https://shapps.dataspace.copernicus.eu/dashboard -> User settings -> OAuth clients -> Create.
# If empty, the app falls back to reading Sentinel-2 COGs from AWS (slower from India).
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# --- Voice (optional) ---
# Sarvam AI gives natural Indian-language TTS (free credits on signup). If empty, gTTS is used.
SARVAM_API_KEY=

# --- Alerts (optional) ---
# Create a bot with @BotFather, send it any message, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# --- App ---
DATABASE_URL=sqlite:///./data/khetdrishti.db
# Contact string sent in the User-Agent to Nominatim / MET Norway (their usage policy requires one).
CONTACT_UA=KhetDrishti/1.0 (Forge26 hackathon; https://github.com/KrisKeshav/khetdrishti)
MONITOR_HOUR_IST=6

# --- Deploy (optional, only for scripts/deploy_hf.py) ---
# WRITE token from https://huggingface.co/settings/tokens and the Space id, e.g. yourname/khetdrishti
HF_TOKEN=
HF_SPACE=
